# Postgres connection string (Neon). Vercel's Neon integration sets this for you.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Password for /admin (at least 8 characters)
ADMIN_PASSWORD=change-me-please

# Random string used to anonymise IP addresses (any long random text)
HASH_SECRET=replace-with-a-long-random-string

# Public URL used in invite links
NEXT_PUBLIC_SITE_URL=https://atlaselevatr.in

# Email sign-in links and the weekly digest (https://resend.com). Without it,
# sign-in and the digest show "not switched on yet"; everything else works.
RESEND_API_KEY=
# Sender address, on a domain verified in Resend
EMAIL_FROM=Atlas <hello@atlaselevatr.in>

# Protects the weekly digest job (/api/cron/digest). Vercel Cron sends it automatically.
CRON_SECRET=replace-with-another-long-random-string
